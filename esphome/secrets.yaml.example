# Copy this file to secrets.yaml, then enter your own values.
# secrets.yaml is in .gitignore. Do not commit it.
#
# The MQTT broker is usually the Home Assistant host. Refer to
# "Prerequisite: MQTT" in the README.

wifi_ssid: "MyWiFiNetwork"
wifi_password: "my-wifi-password"
mqtt_broker: "192.168.1.10"
mqtt_username: "mqtt-user"
mqtt_password: "my-mqtt-password"
wifi_gateway: "192.168.1.1"
wifi_subnet: "255.255.255.0"
wifi_dns: "192.168.1.1"
